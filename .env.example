# RAWNQ — live storefront API configuration
#
# The app runs without any of this: it falls back to the bundled catalogue
# snapshot in assets/data/catalog_snapshot.json (clearly labelled in-app as
# local data). Supply these values to read the live catalogue instead.
#
# These values are NOT committed. The BringUs Supabase project uses a
# publishable "anon" key which is protected by row-level security, but it
# belongs to the BringUs platform — ask the platform operator before shipping
# a build that carries it.
#
# Pass them at build time with --dart-define, or --dart-define-from-file:
#
#   flutter run --dart-define-from-file=.env.json
#   flutter build apk --release \
#     --dart-define=RAWNQ_SUPABASE_URL=... \
#     --dart-define=RAWNQ_SUPABASE_ANON_KEY=... \
#     --dart-define=RAWNQ_TENANT_SLUG=rawnqgaza

RAWNQ_SUPABASE_URL=https://<project-ref>.supabase.co
RAWNQ_SUPABASE_ANON_KEY=<publishable-anon-key>
RAWNQ_TENANT_SLUG=rawnqgaza
